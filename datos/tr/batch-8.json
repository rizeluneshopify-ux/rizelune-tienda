entDigest": "f982864702e27499c00746829674d590e6c75ec8d8c09a7cef80f1f4cffdaabc"}, {"locale": "fr", "key": "section.index.json.hero.etiqueta:1uv1emj4ehbd8", "value": "Économisez", "translatableContentDigest": "9f58c1c48be968bf6454c0ec64531db4879e753e099279a8f76df36b077a36e8"}, {"locale": "pt-PT", "key": "section.index.json.hero.etiqueta:1uv1emj4ehbd8", "value": "Poupe", "translatableContentDigest": "9f58c1c48be968bf6454c0ec64531db4879e753e099279a8f76df36b077a36e8"}, {"locale": "fr", "key": "section.index.json.hero.boton1:ev0e6guuxv3d", "value": "Je veux mon rituel", "translatableContentDigest": "311d349be4362b0cce5a1bfaaa179a6abb4d8b24915f3d7bc220c46fa60731bc"}, {"locale": "pt-PT", "key": "section.index.json.hero.boton1:ev0e6guuxv3d", "value": "Quero o meu ritual", "translatableContentDigest": "311d349be4362b0cce5a1bfaaa179a6abb4d8b24915f3d7bc220c46fa60731bc"}, {"locale": "fr", "key": "section.index.json.hero.boton2:ev0e6guuxvze", "value": "Mode d'emploi", "translatableContentDigest": "353d8e5f5feb41d0062bd2701f486d365454b931e3805486bc87469df7222f12"}, {"locale": "pt-PT", "key": "section.index.json.hero.boton2:ev0e6guuxvze", "value": "Como se usa", "translatableContentDigest": "353d8e5f5feb41d0062bd2701f486d365454b931e3805486bc87469df7222f12"}, {"locale": "fr", "key": "section.index.json.marquesina.items:1se8tw2zvzykc", "value": "Romarin et menthe\nSoin dès la racine\nFormule vegan\nFabriqué dans l'UE\nRituel de 15 minutes", "translatableContentDigest": "e5b357ce6b3eb5c30b8922659f4d5afe0be5ee7d3289289864f97cd4074d875a"}, {"locale": "pt-PT", "key": "section.index.json.marquesina.items:1se8tw2zvzykc", "value": "Alecrim e hortelã-pimenta\nCuida desde a raiz\nFórmula vegana\nFabricado na UE\nRitual de 15 minutos", "translatableContentDigest": "e5b357ce6b3eb5c30b8922659f4d5afe0be5ee7d3289289864f97cd4074d875a"}, {"locale": "fr", "key": "section.index.json.problema.eyebrow:2nnu3lh4pj9ij", "value": "Ça vous parle ?", "translatableContentDigest": "53b341d6863524a0f2f0fedd15b8cd88a3014fb381948ef932f9bc846aff1bdf"}, {"locale": "pt-PT", "key": "section.index.json.problema.eyebrow:2nnu3lh4pj9ij", "value": "Identifica-se?", "translatableContentDigest": "53b341d6863524a0f2f0fedd15b8cd88a3014fb381948ef932f9bc846aff1bdf"}, {"locale": "fr", "key": "section.index.json.problema.titulo:2k327j3brqjdx", "value": "Vos cheveux ne perdent pas leur éclat du jour au <em>lendemain</em>", "translatableContentDigest": "6f9750db6a969ee63d06b03b72526e981d9cc3191e7680ebfe3b65649e6ce578"}, {"locale": "pt-PT", "key": "section.index.json.problema.titulo:2k327j3brqjdx", "value": "O seu cabelo não perde o brilho de um dia para o <em>outro</em>", "translatableContentDigest": "6f9750db6a969ee63d06b03b72526e981d9cc3191e7680ebfe3b65649e6ce578"}, {"locale": "fr", "key": "section.index.json.problema.texto:2sgfi14e4eh4", "value": "Lisseur, colorations, sèche-cheveux, soleil, stress… Peu à peu, les cheveux deviennent secs, cassants et ternes. Et même si nous en prenons soin des longueurs aux pointes, nous oublions presque toujours là où tout commence : la racine.", "translatableContentDigest": "c06f0326bef26d102abb48f09be58bc4a3a6c144bd0960942b4f54b509e58a87"}, {"locale": "pt-PT", "key": "section.index.json.problema.texto:2sgfi14e4eh4", "value": "Pranchas, pintura, secador, sol, stress… Pouco a pouco o cabelo fica seco, quebradiço e sem brilho. E embora cuidemos dele do comprimento às pontas, quase sempre nos esquecemos de onde tudo começa: a raiz.", "translatableContentDigest": "c06f0326bef26d102abb48f09be58bc4a3a6c144bd0960942b4f54b509e58a87"}, {"locale": "fr", "key": "section.index.json.problema.lista_titulo:122xkrufhfw49", "value": "Rizelune est fait pour vous si…", "translatableContentDigest": "8aaaad0c03aa5f15af8cc8c89406c09d07d012ae51681fb10683890d861efeba"}, {"locale": "pt-PT", "key": "section.index.json.problema.lista_titulo:122xkrufhfw49", "value": "O Rizelune é para si se…", "translatableContentDigest": "8aaaad0c03aa5f15af8cc8c89406c09d07d012ae51681fb10683890d861efeba"}, {"locale": "fr", "key": "section.index.json.problema.lista:2sgfhw6b6qqh", "value": "Vos cheveux sont secs, ternes ou cassants\nVous utilisez souvent lisseur, sèche-cheveux ou colorations\nVous sentez que vos cheveux ont perdu force et éclat\nVous voulez prendre soin de votre cuir chevelu, pas seulement des pointes\nVous cherchez un moment de bien-être simple dans votre routine", "translatableContentDigest": "fa1f1fabfbe825edef44e96536e375153f1a3fbccfbc6ad4ec99602c01b57022"}, {"locale": "pt-PT", "key": "section.index.json.problema.lista:2sgfhw6b6qqh", "value": "Tem o cabelo seco, sem brilho ou quebradiço\nUsa com frequência prancha, secador ou pintura\nSente que o seu cabelo perdeu força e brilho\nQuer começar a cuidar do couro cabeludo, não só das pontas\nProcura um momento de autocuidado simples na sua rotina", "translatableContentDigest": "fa1f1fabfbe825edef44e96536e375153f1a3fbccfbc6ad4ec99602c01b57022"}, {"locale": "fr", "key": "section.index.json.problema.boton:2sgfhxegj3mq", "value": "Prendre soin dès la racine", "translatableContentDigest": "25001357b2c5929f6de0c6baa5a6ba5f920c714a780e9cbce9f6d524d768f7b0"}, {"locale": "pt-PT", "key": "section.index.json.problema.boton:2sgfhxegj3mq", "value": "Cuidar desde a raiz", "translatableContentDigest": "25001357b2c5929f6de0c6baa5a6ba5f920c714a780e9cbce9f6d524d768f7b0"}, {"locale": "fr", "key": "section.index.json.ingredientes.eyebrow:s4lgfm87ytbm", "value": "Ce qu'il contient", "translatableContentDigest": "5afb3e034021b8e0692f5f80222e256df180ac47dce522e2f43936be4ffc7a53"}, {"locale": "pt-PT", "key": "section.index.json.ingredientes.eyebrow:s4lgfm87ytbm", "value": "O que tem dentro", "translatableContentDigest": "5afb3e034021b8e0692f5f80222e256df180ac47dce522e2f43936be4ffc7a53"}, {"locale": "fr", "key": "section.index.json.ingredientes.titulo:1ob5i62ccollo", "value": "Peu d'ingrédients, <em>bien</em> choisis", "translatableContentDigest": "628543325f5df782c6ddfa6c0b08a24a2e9ae0049995738ba2fe751b8aecf2be"}, {"locale": "pt-PT", "key": "section.index.json.ingredientes.titulo:1ob5i62ccollo", "value": "Poucos ingredientes, <em>bem</em> escolhidos", "translatableContentDigest": "628543325f5df782c6ddfa6c0b08a24a2e9ae0049995738ba2fe751b8aecf2be"}, {"locale": "fr", "key": "section.index.json.ingredientes.texto:2erlrctyj4ihd", "value": "Un mélange simple d'huiles végétales pensé pour nourrir le cuir chevelu.", "translatableContentDigest": "fcd5d3a624f39453a6f3978ead5375020f81e9fbb881e49bc0a8b34dea7ce217"}, {"locale": "pt-PT", "key": "section.index.json.ingredientes.texto:2erlrctyj4ihd", "value": "Uma mistura simples de óleos vegetais pensada para nutrir o couro cabeludo.", "translatableContentDigest": "fcd5d3a624f39453a6f3978ead5375020f81e9fbb881e49bc0a8b34dea7ce217"}, {"locale": "fr", "key": "section.index.json.ingredientes.i1.titulo:236p87zjg1nrz", "value": "Huile de romarin", "translatableContentDigest": "d3a78e760d5f84b79ccbb7c6e6ac48da014dfad416c2fe0672ceabe09626485c"}, {"locale": "pt-PT", "key": "section.index.json.ingredientes.i1.titulo:236p87zjg1nrz", "value": "Óleo de alecrim", "translatableContentDigest": "d3a78e760d5f84b79ccbb7c6e6ac48da014dfad416c2fe0672ceabe09626485c"}, {"locale": "fr", "key": "section.index.json.ingredientes.i1.texto:2jgq1ztxubmsy", "value": "La star du rituel : nourrit le cuir chevelu et aide vos cheveux à retrouver leur force.", "translatableContentDigest": "00bceaa10dbe72376d5e423af9fc8e39e61ca502f0d6bd5ba9929df20ac7f904"}, {"locale": "pt-PT", "key": "section.index.json.ingredientes.i1.texto:2jgq1ztxubmsy", "value": "O protagonista do ritual: nutre o couro cabeludo e ajuda o cabelo a recuperar a força.", "translatableContentDigest": "00bceaa10dbe72376d5e423af9fc8e39e61ca502f0d6bd5ba9929df20ac7f904"}, {"locale": "fr", "key": "section.index.json.ingredientes.i2.titulo:2ai7gdnxxffto", "value": "Huile de menthe", "translatableContentDigest": "ffcf847e341b924a455a8a1eb81bcc882b0ef9145bb6150843059cf17c143f7c"}, {"locale": "pt-PT", "key": "section.index.json.ingredientes.i2.titulo:2ai7gdnxxffto", "value": "Óleo de hortelã-pimenta", "translatableContentDigest": "ffcf847e341b924a455a8a1eb81bcc882b0ef9145bb6150843059cf17c143f7c"}, {"locale": "fr", "key": "section.index.json.ingredientes.i2.texto:2s6hn15pxa3gx", "value": "Apporte cette sensation de fraîcheur que vous sentirez dès le premier massage.", "translatableContentDigest": "8179733b2ae5f937607a4332d37a9bea49a53bdf1ac0677caf860eb113ae0400"}, {"locale": "pt-PT", "key": "section.index.json.ingredientes.i2.texto:2s6hn15pxa3gx", "value": "Traz aquela sensação de frescura que vai notar desde a primeira massagem.", "translatableContentDigest": "8179733b2ae5f937607a4332d37a9bea49a53bdf1ac0677caf860eb113ae0400"}, {"locale": "fr", "key": "section.index.json.ingredientes.i3.titulo:2azd4c9xksgil", "value": "Huiles végétales", "translatableContentDigest": "61609b393d4a9503cdc6d4e049c58a8f98799cada507f96c44f762a20fb71fd1"}, {"locale": "pt-PT", "key": "section.index.json.ingredientes.i3.titulo:2azd4c9xksgil", "value": "Óleos vegetais", "translatableContentDigest": "61609b393d4a9503cdc6d4e049c58a8f98799cada507f96c44f762a20fb71fd1"}, {"locale": "fr", "key": "section.index.json.ingredientes.i3.texto:10hnfnjky1blc", "value": "Une base légère qui prend soin de la racine et laisse les cheveux doux et lumineux.", "translatableContentDigest": "c4fe3c584bd725c92be41f060ee9f3c7279faac86937a5ea525721f9e71b8f46"}, {"locale": "pt-PT", "key": "section.index.json.ingredientes.i3.texto:10hnfnjky1blc", "value": "Uma base leve que cuida da raiz e deixa o cabelo suave e luminoso.", "translatableContentDigest": "c4fe3c584bd725c92be41f060ee9f3c7279faac86937a5ea525721f9e71b8f46"}, {"locale": "fr", "key": "section.index.json.ingredientes.i4.titulo:2ka5dz5353d96", "value": "Des cheveux plus forts", "translatableContentDigest": "e4d94e563c16a17901c1c78912595384eb854b6e407903b3b2cf5a433c7ab8b6"}, {"locale": "pt-PT", "key": "section.index.json.ingredientes.i4.titulo:2ka5dz5353d96", "value": "Cabelo mais forte", "translatableContentDigest": "e4d94e563c16a17901c1c78912595384eb854b6e407903b3b2cf5a433c7ab8b6"}, {"locale": "fr", "key": "section.index.json.ingredientes.i4.texto:1ui132n111t5j", "value": "Plus de résistance pour les cheveux secs ou cassants, et un éclat qui se voit.", "translatableContentDigest": "beacdbda171ff96f2e0bb955bedfbfbd8ae8ad2b7db7c29ecd9edd7166223fab"}, {"locale": "pt-PT", "key": "section.index.json.ingredientes.i4.texto:1ui132n111t5j", "value": "Mais resistência para o cabelo seco ou quebradiço, e um brilho que se nota.", "translatableContentDigest": "beacdbda171ff96f2e0bb955bedfbfbd8ae8ad2b7db7c29ecd9edd7166223fab"}, {"locale": "fr", "key": "section.index.json.pasos.eyebrow:ade850ql34sf", "value": "Votre rituel", "translatableContentDigest": "df2545f263513816fd46ca53e1848114b1d78fc27df5936a7de2be4dc5bdf139"}, {"locale": "pt-PT", "key": "section.index.json.pasos.eyebrow:ade850ql34sf", "value": "O seu ritual", "translatableContentDigest": "df2545f263513816fd46ca53e1848114b1d78fc27df5936a7de2be4dc5bdf139"}, {"locale": "fr", "key": "section.index.json.pasos.titulo:1b140cbke8m5t", "value": "Trois gestes, <em>quinze</em> minutes", "translatableContentDigest": "7b801aae241d96657451e0ab5836e8691ecfdfd42b5f2884647247f56dbc6505"}, {"locale": "pt-PT", "key": "section.index.json.pasos.titulo:1b140cbke8m5t", "value": "Três gestos, <em>quinze</em> minutos", "translatableContentDigest": "7b801aae241d96657451e0ab5836e8691ecfdfd42b5f2884647247f56dbc6505"}, {"locale": "fr", "key": "section.index.json.pasos.texto:iev9ybba9nbw", "value": "Faites-en votre petit moment de bien-être avant le shampooing.", "translatableContentDigest": "8d37311ffbab3011ef66d7f53a7c6e0ccb88dfd90ef8d5cb9f45735a647bad2a"}, {"locale": "pt-PT", "key": "section.index.json.pasos.texto:iev9ybba9nbw", "value": "Transforme-o no seu pequeno momento de autocuidado antes da lavagem.", "translatableContentDigest": "8d37311ffbab3011ef66d7f53a7c6e0ccb88dfd90ef8d5cb9f45735a647bad2a"}, {"locale": "fr", "key": "section.index.json.pasos.boton:iev9ym2x35ti", "value": "Commencer mon rituel", "translatableContentDigest": "3da36b337f81cc11fc2aa4fb16959d293075a24d3718c706b7827d3335f6aac4"}, {"locale": "pt-PT", "key": "section.index.json.pasos.boton:iev9ym2x35ti", "value": "Começar o meu ritual", "translatableContentDigest": "3da36b337f81cc11fc2aa4fb16959d293075a24d3718c706b7827d3335f6aac4"}, {"locale": "fr", "key": "section.index.json.pasos.p1.titulo:27jj5tnunioej", "value": "Appliquez quelques gouttes", "translatableContentDigest": "360916496b8de32704d791aa905d7be66e65b27170d62c6ff43065a33089073e"}, {"locale": "pt-PT", "key": "section.index.json.pasos.p1.titulo:27jj5tnunioej", "value": "Aplique umas gotas", "translatableContentDigest": "360916496b8de32704d791aa905d7be66e65b27170d62c6ff43065a33089073e"}, {"locale": "fr", "key": "section.index.json.pasos.p1.texto:f5g1czwd01t2", "value": "Avec le compte-gouttes, répartissez quelques gouttes sur le cuir chevelu et les cheveux, avant le shampooing.", "translatableContentDigest": "b587e50db4ce02c0bb4a957bb83360ae4ca199fcb2f2d4ca2b9c32ae5344a0d8"}, {"locale": "pt-PT", "key": "section.index.json.pasos.p1.texto:f5g1czwd01t2", "value": "Com o conta-gotas, distribua umas gotas pelo couro cabeludo e pelo cabelo, antes de o lavar.", "translatableContentDigest": "b587e50db4ce02c0bb4a957bb83360ae4ca199fcb2f2d4ca2b9c32ae5344a0d8"}, {"locale": "fr", "key": "section.index.json.pasos.p1.tiempo:27jj5to9ak326", "value": "Sans gaspiller : flacon de 30 ml", "translatableContentDigest": "2c4763e629f52231f60cdd6e65fd0fc1c1d2739b2e4d7019baff284de31cfaef"}, {"locale": "pt-PT", "key": "section.index.json.pasos.p1.tiempo:27jj5to9ak326", "value": "Sem desperdício: frasco de 30 ml", "translatableContentDigest": "2c4763e629f52231f60cdd6e65fd0fc1c1d2739b2e4d7019baff284de31cfaef"}, {"locale": "fr", "key": "section.index.json.pasos.p2.titulo:2ev1dzc94wgg8", "value": "Massez délicatement", "translatableContentDigest": "38824d6dbb1af81b85cd9bf1e47d75d66a5ebb45aa46e77faab56584d4e9f559"}, {"locale": "pt-PT", "key": "section.index.json.pasos.p2.titulo:2ev1dzc94wgg8", "value": "Massaje suavemente", "translatableContentDigest": "38824d6dbb1af81b85cd9bf1e47d75d66a5ebb45aa46e77faab56584d4e9f559"}, {"locale": "fr", "key": "section.index.json.pasos.p2.texto:nv7mebofyih1", "value": "Du bout des doigts, par mouvements circulaires. Vous sentirez la fraîcheur de la menthe.", "translatableContentDigest": "5f4bc39246d8905c3f61c401f5582e85494230b6a86632cef8d173041cd323d9"}, {"locale": "pt-PT", "key": "section.index.json.pasos.p2.texto:nv7mebofyih1", "value": "Com as pontas dos dedos, em movimentos circulares. Vai notar a frescura da hortelã-pimenta.", "translatableContentDigest": "5f4bc39246d8905c3f61c401f5582e85494230b6a86632cef8d173041cd323d9"}, {"locale": "fr", "key": "section.index.json.pasos.p2.tiempo:2ev1dzck1pa7x", "value": "Votre moment pour vous", "translatableContentDigest": "3945fc917656c33aea864ec5594d5cc0a42ea24815c4c3402c9d6e9a62207136"}, {"locale": "pt-PT", "key": "section.index.json.pasos.p2.tiempo:2ev1dzck1pa7x", "value": "O seu momento de autocuidado", "translatableContentDigest": "3945fc917656c33aea864ec5594d5cc0a42ea24815c4c3402c9d6e9a62207136"}, {"locale": "fr", "key": "section.index.json.pasos.p3.titulo:2fc71xy8s9h55", "value": "Laissez agir puis lavez", "translatableContentDigest": "b5818bf712d182bade54aadb459cccd24f03d5cdf2ffc5e011cb1a10c006ab33"}, {"locale": "pt-PT", "key": "section.index.json.pasos.p3.titulo:2fc71xy8s9h55", "value": "Deixe atuar e lave", "translatableContentDigest": "b5818bf712d182bade54aadb459cccd24f03d5cdf2ffc5e011cb1a10c006ab33"}, {"locale": "fr", "key": "section.index.json.pasos.p3.texto:2sbrg1rpli7dw", "value": "Laissez agir au moins 15 minutes, puis lavez vos cheveux comme d'habitude. À répéter 1 à 2 fois par semaine.", "translatableContentDigest": "b56456f2a738eb0d2f313b525007bf0bb23b29957ea72fdd78c8904e26d31252"}, {"locale": "pt-PT", "key": "section.index.json.pasos.p3.texto:2sbrg1rpli7dw", "value": "Deixe atuar pelo menos 15 minutos e depois lave o cabelo como de costume. Repita 1–2 vezes por semana.", "translatableContentDigest": "b56456f2a738eb0d2f313b525007bf0bb23b29957ea72fdd78c8904e26d31252"}, {"locale": "fr", "key": "section.index.json.pasos.p3.tiempo:2fc71xyn9tp4s", "value": "15 minutes minimum", "translatableContentDigest": "91348f2f140f93c808401fe274f3e4fc2383686518e8b4a92199629db4911dfd"}, {"locale": "pt-PT", "key": "section.index.json.pasos.p3.tiempo:2fc71xyn9tp4s", "value": "Mínimo 15 minutos", "translatableContentDigest": "91348f2f140f93c808401fe274f3e4fc2383686518e8b4a92199629db4911dfd"}, {"locale": "fr", "key": "section.index.json.beneficios.eyebrow:144cri2q31ous", "value": "Pourquoi ça marche", "translatableContentDigest": "b6cec23df74c03ba873dfb438573af5ef3c3e93e9fa0ce66fa80361f7704e53d"}, {"locale": "pt-PT", "key": "section.index.json.beneficios.eyebrow:144cri2q31ous", "value": "Porque funciona", "translatableContentDigest": "b6cec23df74c03ba873dfb438573af5ef3c3e93e9fa0ce66fa80361f7704e53d"}, {"locale": "fr", "key": "section.index.json.beneficios.titulo:i7bwdgdg14ai", "value": "Prenez soin de la racine, <em>révélez</em> le résultat", "translatableContentDigest": "a89e707a5f6f74f06c2afd8dcd17360d1a43103cea6149275f3fcfc966ce0fdb"}, {"locale": "pt-PT", "key": "section.index.json.beneficios.titulo:i7bwdgdg14ai", "value": "Cuide da raiz, <em>exiba</em> o resultado", "translatableContentDigest": "a89e707a5f6f74f06c2afd8dcd17360d1a43103cea6149275f3fcfc966ce0fdb"}, {"locale": "fr", "key": "section.index.json.beneficios.texto:1wi3w0x95vyrb", "value": "Pensé pour votre routine de tous les jours.", "translatableContentDigest": "cf964cc87e24d01ba31baab98275aa682bf685aaee33a6e394df826cf551383f"}, {"locale": "pt-PT", "key": "section.index.json.beneficios.texto:1wi3w0x95vyrb", "value": "Pensado para a sua rotina de sempre.", "translatableContentDigest": "cf964cc87e24d01ba31baab98275aa682bf685aaee33a6e394df826cf551383f"}, {"locale": "fr", "key": "section.index.json.beneficios.b1.titulo:10plijxasxuxe", "value": "Nourrit le cuir chevelu", "translatableContentDigest": "a4696f5fae7c71519edb78de4184b6f0337ba9d9bfeacb41c5b449be4f315b4e"}, {"locale": "pt-PT", "key": "section.index.json.beneficios.b1.titulo:10plijxasxuxe", "value": "Nutre o couro cabeludo", "translatableContentDigest": "a4696f5fae7c71519edb78de4184b6f0337ba9d9bfeacb41c5b449be4f315b4e"}, {"locale": "fr", "key": "section.index.json.beneficios.b1.texto:1stenxt24mokf", "value": "Sa formule aux huiles végétales prend soin de la racine et laisse une sensation de fraîcheur grâce à la menthe.", "translatableContentDigest": "184be6417c9a359b8912f390daab5f0b3e0db640b4349a68c0ac10779e071d44"}, {"locale": "pt-PT", "key": "section.index.json.beneficios.b1.texto:1stenxt24mokf", "value": "A sua fórmula com óleos vegetais cuida da raiz e deixa uma sensação de frescura graças à hortelã-pimenta.", "translatableContentDigest": "184be6417c9a359b8912f390daab5f0b3e0db640b4349a68c0ac10779e071d44"}, {"locale": "fr", "key": "section.index.json.beneficios.b2.titulo:aw7qa28ggvbl", "value": "Fortifie les cheveux", "translatableContentDigest": "addd9329f75184588d278377ff5ad669c569a34ea5172c6d8155a2e8e67b3b6e"}, {"locale": "pt-PT", "key": "section.index.json.beneficios.b2.titulo:aw7qa28ggvbl", "value": "Fortalece o cabelo", "translatableContentDigest": "addd9329f75184588d278377ff5ad669c569a34ea5172c6d8155a2e8e67b3b6e"}, {"locale": "fr", "key": "section.index.json.beneficios.b2.texto:8tnzrmwdbjb0", "value": "Aide à améliorer la résistance des cheveux secs ou cassants.", "translatableContentDigest": "c6970f07bb61c0ad9463dca273c29e37207efcf242f6d62436e0c388625a2161"}, {"locale": "pt-PT", "key": "section.index.json.beneficios.b2.texto:8tnzrmwdbjb0", "value": "Ajuda a melhorar a resistência do cabelo seco ou quebradiço.", "translatableContentDigest": "c6970f07bb61c0ad9463dca273c29e37207efcf242f6d62436e0c388625a2161"}, {"locale": "fr", "key": "section.index.json.beneficios.b3.titulo:af22bg8t3umo", "value": "Redonne de l'éclat", "translatableContentDigest": "655af15e97b33d3f970f1985eef747f04277df4c937298850c9876e143b158a0"}, {"locale": "pt-PT", "key": "section.index.json.beneficios.b3.titulo:af22bg8t3umo", "value": "Devolve o brilho", "translatableContentDigest": "655af15e97b33d3f970f1985eef747f04277df4c937298850c9876e143b158a0"}, {"locale": "fr", "key": "section.index.json.beneficios.b3.texto:20ii7591ckb6l", "value": "Vos cheveux paraissent plus sains, doux et lumineux.", "translatableContentDigest": "14c62241c2452e08873b1dae1f4362d0143669e53fc2de25455956f914cd55ed"}, {"locale": "pt-PT", "key": "section.index.json.beneficios.b3.texto:20ii7591ckb6l", "value": "O seu cabelo parece mais saudável, suave e luminoso.", "translatableContentDigest": "14c62241c2452e08873b1dae1f4362d0143669e53fc2de25455956f914cd55ed"}, {"locale": "fr", "key": "section.index.json.beneficios.b4.titulo:jm5csrr3w5g7", "value": "Naturel et vegan", "translatableContentDigest": "20e525991c69ac8f07e6af2742d909480ad1d5f229bb5ae2085bec13908993e6"}, {"locale": "pt-PT", "key": "section.index.json.beneficios.b4.titulo:jm5csrr3w5g7", "value": "Natural e vegano", "translatableContentDigest": "20e525991c69ac8f07e6af2742d909480ad1d5f229bb5ae2085bec13908993e6"}, {"locale": "fr", "key": "section.index.json.beneficios.b4.texto:2hs3muzyxwi7u", "value": "Formule vegan, fabriquée dans l'UE avec certification qualité.", "translatableContentDigest": "9db4b54f6a8862eb878c60754b947e2999ca8f5b49e945b348f1d9d8fc8774db"}, {"locale": "pt-PT", "key": "section.index.json.beneficios.b4.texto:2hs3muzyxwi7u", "value": "Fórmula vegana, fabricada na UE com certificação de qualidade.", "translatableContentDigest": "9db4b54f6a8862eb878c60754b947e2999ca8f5b49e945b348f1d9d8fc8774db"}, {"locale": "fr", "key": "section.index.json.beneficios.c1.sufijo:2m79su07c1sxs", "value": "min", "translatableContentDigest": "1f6fa6f69d185e6086d04e7330361bf9001a3b8d0ce511171055dc34eb90c1c5"}, {"locale": "pt-PT", "key": "section.index.json.beneficios.c1.sufijo:2m79su07c1sxs", "value": "min", "translatableContentDigest": "1f6fa6f69d185e6086d04e7330361bf9001a3b8d0ce511171055dc34eb90c1c5"}]}