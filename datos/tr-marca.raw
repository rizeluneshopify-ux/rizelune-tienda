        "digest": "f5e47697d213ec9104af831f5889ae224abcfd3ae94a3bfa170c523f6d4ecb92"
      },
      {
        "key": "section.index.json.ingredientes.i4.titulo:2ka5dz5353d96",
        "value": "Tu pelo, más fuerte",
        "digest": "e4d94e563c16a17901c1c78912595384eb854b6e407903b3b2cf5a433c7ab8b6"
      },
      {
        "key": "section.index.json.ingredientes.i4.texto:1ui132n111t5j",
        "value": "Más resistencia para el pelo seco o quebradizo, y un brillo que se nota.",
        "digest": "beacdbda171ff96f2e0bb955bedfbfbd8ae8ad2b7db7c29ecd9edd7166223fab"
      },
      {
        "key": "section.index.json.pasos.imagen:1b140nh502n47",
