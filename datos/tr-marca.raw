        "digest": "ff69e846672a503c2836d9fb404f52e4014136d5ac3a58e4e82c5fd36260f0a5"
      },
      {
        "key": "section.index.json.ingredientes.i1.titulo:236p87zjg1nrz",
        "value": "Aceite de romero",
        "digest": "d3a78e760d5f84b79ccbb7c6e6ac48da014dfad416c2fe0672ceabe09626485c"
      },
      {
        "key": "section.index.json.ingredientes.i1.texto:2jgq1ztxubmsy",
        "value": "El protagonista del ritual: nutre el cuero cabelludo y ayuda a que tu pelo recupere fuerza.",
        "digest": "00bceaa10dbe72376d5e423af9fc8e39e61ca502f0d6bd5ba9929df20ac7f904"
      },
      {
        "key": "section.index.json.ingredientes.i2.imagen:2ai7gjwbwv1t6",
