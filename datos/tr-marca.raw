        "digest": "d200dd5e05ad1408062b2ade0ba429269d7909de93f1e93d53bde6c76da7b9c4"
      },
      {
        "key": "section.page.nosotros.json.valores.v4.titulo:1aeqtvze5xqde",
        "value": "Fórmula vegana",
        "digest": "dcb2d701d0540d9af3da522e90b1ac810b8ba799a34343eabb52e42c345f7aa8"
      },
      {
        "key": "section.page.nosotros.json.valores.v4.texto:3cbkcorsn9w3z",
        "value": "Sin ingredientes de origen animal",
        "digest": "9806bda1448ae832236faa0afd57b6a2c63476aef7388981fd79e7c9928ed0f9"
      },
      {
        "key": "section.page.nosotros.json.como.imagen:3hm53b3aje5v7",
        "value": "shopify://shop_images/tienda.webp",
        "digest": "ff69e846672a503c2836d9fb404f52e4014136d5ac3a58e4e82c5fd36260f0a5"
      },
      {
        "key": "section.page.nosotros.json.como.imagen_respaldo:2m1l2akf9f4vy",
        "value": "rz-hero.jpg",
        "digest": "571fb15294b480a0f941db51a38f85f3d2e9461bfe1c5bb8ce456289ae5245d9"
      },
      {
        "key": "section.page.nosotros.json.como.eyebrow:28yd1vjpxsn2j",
        "value": "Cómo trabajamos",
        "digest": "0cf2aecd8847b8b25f571f3f2ffc747b863c43500ca52d7593a56112dde7137e"
      },
      {
        "key": "section.page.nosotros.json.como.titulo:3hm53czgv8fut",
        "value": "Del laboratorio <em>a tu casa</em>",
        "digest": "8a7f943cba3448cd00d8dc100e768768d7c8b2f54bb84eaa44ad051226def1d2"
      },
      {
        "key": "section.page.nosotros.json.como.texto:2gquh37rwek2w",
        "value": "Nuestros productos se fabrican en un laboratorio certificado de la Unión Europea, con fórmulas que cumplen la normativa europea de cosméticos. Cada pedido se prepara allí y se envía directamente a tu casa.\n\n¿Tienes dudas o quieres contarnos qué tal te va? Escríbenos: nos encanta leerte.",
        "digest": "0d190c587a2e69502893144a78fad0167790755f17d39b35e94736eeef99456f"
      },
      {
        "key": "section.page.nosotros.json.como.lista_titulo:gwchg8wnu62h",
        "value": "Así lo hacemos",
        "digest": "2b5f6dc0d2ec598401944a0d0eaec65ca48d2698c9ce94214ae24639e1e41de4"
      },
      {
        "key": "section.page.nosotros.json.como.lista:2gquh32ttgt2x",
        "value": "Fórmulas fabricadas en la Unión Europea\nEnvío directo a tu casa, con número de seguimiento\nPago 100 % seguro\nTe respondemos personalmente por email",
        "digest": "fdd5c67b320caadd04ce4449a06ea8bbff874a429a981f8d6f282bc3aab7a94a"
      },
      {
        "key": "section.page.nosotros.json.como.boton:2gquh2zl58fb6",
        "value": "Escríbenos",
        "digest": "e9c82906e1af47e904cd57a3a62b34775531eee3764e4266ca59231020baa6c5"
      },
      {
        "key": "section.page.nosotros.json.como.boton_url:5awuuyrertau",
        "value": "/pages/contact",
        "digest": "e4ca42986b02474ae900bc53b135e33b8f475232021a61048d156743086cd71b"
      },
      {
        "key": "section.page.nosotros.json.compra.imagen:14pi8sdtbymf3",
        "value": "shopify://shop_images/rizelune_2.jpg",
        "digest": "b70b33288e751e29846e9406d21033d23cd2384cf4020460d2580c8511194403"
      },
      {
        "key": "section.page.nosotros.json.compra.eyebrow:2a17yo8vtldon",
        "value": "Rizelune",
        "digest": "35af6ab0adbd6420303eab846907e5d4ecff364372f8854e3348202822193f08"
