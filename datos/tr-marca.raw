        "digest": "c1fb206c4e057afc28135f95052b7773fd93a38232c2e299cd55fd47e1f7a7a5"
      },
      {
        "key": "section.index.json.ingredientes.i3.titulo:2azd4c9xksgil",
        "value": "Aceites vegetales",
        "digest": "61609b393d4a9503cdc6d4e049c58a8f98799cada507f96c44f762a20fb71fd1"
      },
      {
        "key": "section.index.json.ingredientes.i3.texto:10hnfnjky1blc",
        "value": "Una base ligera que cuida la raíz y deja el pelo suave y luminoso.",
        "digest": "c4fe3c584bd725c92be41f060ee9f3c7279faac86937a5ea525721f9e71b8f46"
      },
      {
        "key": "section.index.json.ingredientes.i4.imagen:2ka5e114g6j8s",
