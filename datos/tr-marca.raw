        "digest": "272977ec7f92493c63e430ddd2bcfede1020e7c4c425552aead3b2dda65705b3"
      },
      {
        "key": "section.index.json.ingredientes.i2.titulo:2ai7gdnxxffto",
        "value": "Aceite de menta",
        "digest": "ffcf847e341b924a455a8a1eb81bcc882b0ef9145bb6150843059cf17c143f7c"
      },
      {
        "key": "section.index.json.ingredientes.i2.texto:2s6hn15pxa3gx",
        "value": "Aporta esa sensación de frescor que notarás desde el primer masaje.",
        "digest": "8179733b2ae5f937607a4332d37a9bea49a53bdf1ac0677caf860eb113ae0400"
      },
      {
        "key": "section.index.json.ingredientes.i3.imagen:2azd4jgz9el4b",
