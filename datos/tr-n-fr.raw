      },
      {
        "key": "section.index.json.garantias.g4.texto:13p2a5b8d9vzy",
        "value": "En España a partir de 45 €",
        "digest": "b5939cbf8d9e0577d46810765aabe0ee5dedef570a5c3bc2f07530f8e1ea6f41"
