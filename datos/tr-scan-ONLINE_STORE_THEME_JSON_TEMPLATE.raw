          {
            "key": "section.index.json.ritual.titulo:3bxlgz367q3mg",
            "value": "Un petit geste qui devient une <em>habitude</em>"
          },
          {
            "key": "section.index.json.ritual.texto:1ecms4ow0juz9",
            "value": "Allumez une bougie, installez-vous confortablement et offrez-vous quinze minutes. Rizelune transforme un geste aussi simple que votre shampooing en un petit rituel de soin."
          },
          {
            "key": "section.index.json.ritual.lista:1ecms4tu6b3lw",
