          {
            "key": "section.product.rz.json.principal.k2.texto:28vdgh1a8yv4x",
            "value": "Plus de résistance pour les cheveux secs"
          },
          {
            "key": "section.product.rz.json.principal.k3.titulo:c4ja53hm7rhp",
