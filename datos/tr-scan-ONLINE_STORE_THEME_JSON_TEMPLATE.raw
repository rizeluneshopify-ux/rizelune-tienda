          {
            "key": "section.index.json.ingredientes.i4.texto:1ui132n111t5j",
            "value": "Más resistencia para el pelo seco o quebradizo, y un brillo que se nota."
          },
          {
            "key": "section.index.json.pasos.imagen:1b140nh502n47",
