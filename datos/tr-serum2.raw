        "value": "Óleo de hortelã-pimenta",
        "outdated": false
      },
      {
        "key": "section.index.json.ingredientes.i2.texto:2s6hn15pxa3gx",
        "value": "Traz aquela sensação de frescura que vai notar desde a primeira massagem.",
        "outdated": false
