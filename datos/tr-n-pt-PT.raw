      {
        "key": "section.page.nosotros.json.como.eyebrow:28yd1vjpxsn2j",
        "value": "Cómo trabajamos",
        "digest": "0cf2aecd8847b8b25f571f3f2ffc747b863c43500ca52d7593a56112dde7137e"
      },
      {
        "key": "section.page.nosotros.json.como.titulo:3hm53czgv8fut",
        "value": "Del laboratorio <em>a tu casa</em>",
        "digest": "8a7f943cba3448cd00d8dc100e768768d7c8b2f54bb84eaa44ad051226def1d2"
      },
      {
        "key": "section.page.nosotros.json.como.texto:2gquh37rwek2w",
        "value": "Nuestros productos se fabrican en un laboratorio certificado de la Unión Europea, con fórmulas que cumplen la normativa europea de cosméticos. Cada pedido se prepara allí y se envía directamente a tu casa.\n\n¿Tienes dudas o quieres contarnos qué tal te va? Escríbenos: nos encanta leerte.",
        "digest": "0d190c587a2e69502893144a78fad0167790755f17d39b35e94736eeef99456f"
      },
      {
        "key": "section.page.nosotros.json.como.lista_titulo:gwchg8wnu62h",
        "value": "Así lo hacemos",
        "digest": "2b5f6dc0d2ec598401944a0d0eaec65ca48d2698c9ce94214ae24639e1e41de4"
      },
      {
        "key": "section.page.nosotros.json.como.lista:2gquh32ttgt2x",
        "value": "Fórmulas fabricadas en la Unión Europea\nEnvío directo a tu casa, con número de seguimiento\nPago 100 % seguro\nTe respondemos personalmente por email",
        "digest": "fdd5c67b320caadd04ce4449a06ea8bbff874a429a981f8d6f282bc3aab7a94a"
      },
      {
