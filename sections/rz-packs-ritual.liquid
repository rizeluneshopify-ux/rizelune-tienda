{%- comment -%}
  Packs de portada (versión visual): 3 tarjetas sobre fondo verde oscuro: Ritual Raíz (pack 1), Ritual Completo (pack 3, destacado) y Pelo y Piel (pack 2).
  Productos y precios: Configuración del tema → Rizelune · Packs de rutina (rz_ritualN_a/b/c, rz_ritualN_precio, rz_ritualN_precio_bf, rz_ritualN_sin_rebaja, rz_ritualN_imagen).
  En Black Week (snippet rz-bf-on) toma el precio BW. El precio por separado nunca sale tachado. Con «sin rebaja» no sale el «Ahorras» fuera de la Black Week.
  El botón añade todos los productos del pack (JS: initRitual, selector .rz-pr__card).
{%- endcomment -%}
{{ 'rz-styles.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} { background: {{ section.settings.bg }}; color: {{ section.settings.fg }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; position: relative; overflow: hidden; }
  @media (max-width: 749px) { #shopify-section-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.65 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.65 | round }}px; } }
  .rz-pr__head { text-align: center; max-width: 640px; margin: 0 auto 40px; }
  .rz-pr__head .rz-eyebrow { justify-content: center; color: #E5C18F; }
  .rz-pr__head .rz-h2 { color: var(--rz-crema); font-size: clamp(30px, 4vw, 46px); }
  .rz-pr__head .rz-h2 em { color: #E5C18F; }
  .rz-pr__intro { margin: 0; opacity: .85; }
  .rz-pr__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; align-items: center; }
  @media (max-width: 989px) { .rz-pr__grid { grid-template-columns: minmax(0, 1fr); max-width: 460px; margin: 0 auto; } .rz-pr__card.is-star { order: -1; } }
  .rz-pr__card { position: relative; background: var(--rz-crema); color: var(--rz-romero); border-radius: 26px; padding: 26px 22px 22px; display: grid; gap: 12px; text-align: center; box-shadow: 0 24px 50px -30px rgba(0, 0, 0, .6); transition: transform .4s var(--rz-ease); }
  @media (hover: hover) { .rz-pr__card:hover { transform: translateY(-4px); } }
  .rz-pr__card.is-star { background: #fff; padding-top: 34px; outline: 2px solid #C8975A; outline-offset: -2px; }
  @media (min-width: 990px) { .rz-pr__card.is-star { transform: scale(1.04); } .rz-pr__card.is-star:hover { transform: scale(1.04) translateY(-4px); } }
  .rz-pr__ribbon { position: absolute; top: -13px; left: 50%; transform: translateX(-50%); background: #C8975A; color: #1F2620; font-size: 12px; font-weight: 600; letter-spacing: .06em; padding: 6px 14px; border-radius: 999px; white-space: nowrap; }
  .rz-pr__bf { justify-self: center; background: #141414; color: #fff; font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; padding: 4px 10px; border-radius: 4px; }
  .rz-pr__visual { display: flex; justify-content: center; align-items: center; min-height: 120px; }
  .rz-pr__dot { width: 96px; height: 96px; border-radius: 50%; overflow: hidden; border: 4px solid var(--rz-crema); background: var(--rz-crema-2); box-shadow: 0 10px 22px -14px rgba(0, 0, 0, .45); flex: none; }
  .rz-pr__card.is-star .rz-pr__dot { border-color: #fff; }
  .rz-pr__dot img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .rz-pr__plus { width: 28px; height: 28px; margin: 0 -10px; z-index: 1; border-radius: 50%; background: var(--rz-romero); color: var(--rz-crema); display: grid; place-items: center; font-weight: 600; font-size: 16px; flex: none; }
  .rz-pr__photo { width: 100%; aspect-ratio: 16 / 10; border-radius: 16px; overflow: hidden; background: var(--rz-crema-2); }
  .rz-pr__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .rz-pr__name { font-family: var(--rz-serif); font-weight: 500; font-size: 25px; margin: 4px 0 0; line-height: 1.15; }
  .rz-pr__for { margin: 0; font-size: 14px; color: var(--rz-texto-suave); }
  .rz-pr__inside { list-style: none; margin: 2px 0 0; padding: 0; display: grid; gap: 6px; font-size: 14px; }
  .rz-pr__inside li { display: flex; align-items: center; gap: 8px; }
  .rz-pr__ok { flex: none; display: inline-grid; place-items: center; color: #C8975A; }
  .rz-pr__ok svg { width: 15px; height: 15px; }
  .rz-pr__price { display: grid; gap: 2px; margin-top: 4px; }
  .rz-pr__price strong { font-size: 32px; font-weight: 600; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .rz-pr__price span { font-size: 13px; color: var(--rz-texto-suave); }
  .rz-pr__save { justify-self: center; background: #f3e4cf; color: #7a4f1d; font-size: 13px; font-weight: 600; padding: 5px 12px; border-radius: 999px; }
  .rz-pr__btn { width: 100%; padding: 15px 20px; margin-top: 4px; }
  .rz-pr__err { margin: 0; font-size: 13px; color: #a23b2a; }
  .rz-pr__solo { text-align: center; margin: 34px 0 0; font-size: 15px; opacity: .92; }
  .rz-pr__solo a { color: #E5C18F; font-weight: 500; text-underline-offset: 3px; }
{%- endstyle -%}
{%- capture bf_on -%}{%- render 'rz-bf-on' -%}{%- endcapture -%}
<section class="rz-pr" id="{{ section.settings.ancla | default: section.id }}">
  <div class="rz-container">
    <header class="rz-pr__head rz-reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="rz-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="rz-h2">{{ section.settings.titulo }}</h2>
      {%- if section.settings.texto != blank -%}<p class="rz-pr__intro">{{ section.settings.texto }}</p>{%- endif -%}
    </header>

    <div class="rz-pr__grid">
      {%- assign orden = '1,3,2' | split: ',' -%}
      {%- for n in orden -%}
        {%- capture pre %}rz_ritual{{ n }}_{% endcapture -%}
        {%- assign k_on = pre | append: 'activo' -%}{%- assign k_a = pre | append: 'a' -%}{%- assign k_b = pre | append: 'b' -%}{%- assign k_c = pre | append: 'c' -%}
        {%- assign k_p = pre | append: 'precio' -%}{%- assign k_bf = pre | append: 'precio_bf' -%}{%- assign k_sr = pre | append: 'sin_rebaja' -%}{%- assign k_img = pre | append: 'imagen' -%}
        {%- assign pa = settings[k_a] -%}{%- assign pb = settings[k_b] -%}{%- assign pc = settings[k_c] -%}
        {%- unless settings[k_on] and pa != blank and pb != blank and pa.available and pb.available -%}{%- continue -%}{%- endunless -%}
        {%- assign con_c = false -%}
        {%- if pc != blank -%}{%- unless pc.available -%}{%- continue -%}{%- endunless -%}{%- assign con_c = true -%}{%- endif -%}
        {%- assign va = pa.selected_or_first_available_variant -%}{%- assign vb = pb.selected_or_first_available_variant -%}
        {%- assign separado = va.price | plus: vb.price -%}
        {%- if con_c -%}{%- assign vc = pc.selected_or_first_available_variant -%}{%- assign separado = separado | plus: vc.price -%}{%- endif -%}
        {%- assign precio = settings[k_p] | default: '0' | replace: ',', '.' | strip | times: 100 | round -%}
        {%- assign es_bf = false -%}
        {%- if bf_on == '1' and settings[k_bf] != blank -%}
          {%- assign pbf = settings[k_bf] | replace: ',', '.' | strip | times: 100 | round -%}
          {%- if pbf > 0 and pbf < precio -%}{%- assign precio = pbf -%}{%- assign es_bf = true -%}{%- endif -%}
        {%- endif -%}
        {%- if precio <= 0 or precio > separado -%}{%- assign precio = separado -%}{%- endif -%}
        {%- assign ahorro = separado | minus: precio -%}
        {%- if settings[k_sr] and es_bf == false -%}{%- assign ahorro = 0 -%}{%- endif -%}
        {%- assign star = false -%}{%- if n == '3' -%}{%- assign star = true -%}{%- endif -%}
        {%- case n -%}
          {%- when '1' -%}{%- assign para = section.settings.para1 -%}
          {%- when '2' -%}{%- assign para = section.settings.para2 -%}
          {%- else -%}{%- assign para = section.settings.para3 -%}
        {%- endcase -%}
        {%- capture nombre_k %}rizelune.ritual{{ n }}_name{% endcapture -%}
        <article class="rz-pr__card{% if star %} is-star{% endif %} rz-reveal">
          {%- if star and section.settings.ribbon != blank -%}<span class="rz-pr__ribbon">{{ section.settings.ribbon }}</span>{%- endif -%}
          {%- if es_bf -%}<span class="rz-pr__bf">{{ settings.rz_bf_etiqueta | default: 'Black Week' }}</span>{%- endif -%}
          {%- if star and settings[k_img] != blank -%}
            <div class="rz-pr__photo">{{ settings[k_img] | image_url: width: 800 | image_tag: loading: 'lazy', alt: '', widths: '400,600,800', sizes: '(min-width: 990px) 360px, 92vw' }}</div>
          {%- else -%}
            <div class="rz-pr__visual" aria-hidden="true">
              <span class="rz-pr__dot">{%- if pa.featured_image -%}{{ pa.featured_image | image_url: width: 220 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}</span>
              <span class="rz-pr__plus">+</span>
              <span class="rz-pr__dot">{%- if pb.featured_image -%}{{ pb.featured_image | image_url: width: 220 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}</span>
              {%- if con_c -%}<span class="rz-pr__plus">+</span><span class="rz-pr__dot">{%- if pc.featured_image -%}{{ pc.featured_image | image_url: width: 220 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}</span>{%- endif -%}
            </div>
          {%- endif -%}
          <h3 class="rz-pr__name">{{ nombre_k | t }}</h3>
          {%- if para != blank -%}<p class="rz-pr__for">{{ para }}</p>{%- endif -%}
          <ul class="rz-pr__inside">
            <li><span class="rz-pr__ok" aria-hidden="true">{% render 'rz-icon', name: 'check' %}</span>{{ pa.title }}</li>
            <li><span class="rz-pr__ok" aria-hidden="true">{% render 'rz-icon', name: 'check' %}</span>{{ pb.title }}</li>
            {%- if con_c -%}<li><span class="rz-pr__ok" aria-hidden="true">{% render 'rz-icon', name: 'check' %}</span>{{ pc.title }}</li>{%- endif -%}
          </ul>
          <div class="rz-pr__price">
            <strong>{{ precio | money }}</strong>
            <span>{{ section.settings.sep_txt }}: {{ separado | money }}</span>
          </div>
          {%- if ahorro > 0 -%}<span class="rz-pr__save">{{ section.settings.ahorro_txt }} {{ ahorro | money }}</span>{%- endif -%}
          {%- capture items -%}[{"id":{{ va.id }},"quantity":1},{"id":{{ vb.id }},"quantity":1}{% if con_c %},{"id":{{ vc.id }},"quantity":1}{% endif %}]{%- endcapture -%}
          <button type="button" class="rz-btn rz-pr__btn" data-rz-ritual data-items='{{ items }}'>{{ section.settings.boton }}</button>
          <p class="rz-pr__err" data-rz-ritual-err hidden>{{ 'rizelune.ritual_error' | t }}</p>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.solo and settings.rz_packs_activo and settings.rz_pack_producto != blank -%}
      {%- assign sp = settings.rz_pack_producto -%}
      {%- assign sp2 = settings.rz_pack2_precio | default: '0' | replace: ',', '.' | strip | times: 100 | round -%}
      {%- assign sp3 = settings.rz_pack3_precio | default: '0' | replace: ',', '.' | strip | times: 100 | round -%}
      <p class="rz-pr__solo rz-reveal">{{ section.settings.solo_txt }} <a href="{{ sp.url }}">2 frascos por {{ sp2 | money }} · 3 por {{ sp3 | money }} →</a></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rizelune · Packs ritual",
  "tag": "div",
  "class": "rz-pr-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Packs" },
    { "type": "text", "id": "titulo", "label": "Título (admite <em>)", "default": "Tu ritual, <em>en pack</em>" },
    { "type": "textarea", "id": "texto", "label": "Texto", "default": "Los tres productos están pensados para usarse juntos. En pack, pagas menos." },
    { "type": "text", "id": "para1", "label": "Pack 1 · para quién", "default": "Para cuidar la raíz a fondo" },
    { "type": "text", "id": "para3", "label": "Pack 3 · para quién", "default": "Todo tu ritual de noche: pelo y piel" },
    { "type": "text", "id": "para2", "label": "Pack 2 · para quién", "default": "Pelo y cara en el mismo momento" },
    { "type": "text", "id": "ribbon", "label": "Cinta del pack destacado", "default": "El más completo" },
    { "type": "text", "id": "emoji_a", "label": "(Sin uso) Emoji del sérum" },
    { "type": "text", "id": "emoji_b", "label": "(Sin uso) Emoji del exfoliante" },
    { "type": "text", "id": "emoji_c", "label": "(Sin uso) Emoji del aceite facial" },
    { "type": "text", "id": "sep_txt", "label": "Texto «por separado»", "default": "Por separado" },
    { "type": "text", "id": "ahorro_txt", "label": "Texto «ahorras»", "default": "Ahorras" },
    { "type": "text", "id": "boton", "label": "Texto del botón", "default": "Añadir el pack" },
    { "type": "checkbox", "id": "solo", "label": "Mostrar la línea de packs de sérum", "default": true },
    { "type": "text", "id": "solo_txt", "label": "Texto de la línea", "default": "¿Solo el sérum?" },
    { "type": "text", "id": "ancla", "label": "Ancla (id)", "default": "rz-packs" },
    { "type": "color", "id": "bg", "label": "Fondo", "default": "#2F3B2E" },
    { "type": "color", "id": "fg", "label": "Texto", "default": "#F5EFE6" },
    { "type": "range", "id": "padding_top", "label": "Espacio arriba", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 92 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio abajo", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 92 }
  ],
  "presets": [{ "name": "Rizelune · Packs ritual" }]
}
{% endschema %}
