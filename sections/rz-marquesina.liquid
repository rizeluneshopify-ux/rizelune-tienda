{{ 'rz-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'rz-scripts.js' | asset_url }}" defer="defer"></script>
{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg }};
    color: {{ section.settings.fg }};
  }
  #shopify-section-{{ section.id }} .rz-h1,
  #shopify-section-{{ section.id }} .rz-h2 { font-size: {{ section.settings.heading_size }}px; }
  #shopify-section-{{ section.id }} .rz-body { font-size: {{ section.settings.body_size }}px; }
  #shopify-section-{{ section.id }} .rz-head { text-align: {{ section.settings.text_align }}; }
  #shopify-section-{{ section.id }} .rz-head .rz-eyebrow { justify-content: {% case section.settings.text_align %}{% when 'center' %}center{% when 'right' %}flex-end{% else %}flex-start{% endcase %}; }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.65 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.65 | round }}px; }
    #shopify-section-{{ section.id }} .rz-h1,
    #shopify-section-{{ section.id }} .rz-h2 { font-size: {{ section.settings.heading_size | times: 0.68 | round }}px; }
  }
  #shopify-section-{{ section.id }} .rz-marquee__item { font-size: {{ section.settings.heading_size }}px; }
{%- endstyle -%}
{%- assign lines = section.settings.items | newline_to_br | split: '<br />' -%}
<div class="rz-marquee rz-section" style="--rz-speed: {{ section.settings.velocidad }}s;">
  <div class="rz-marquee__track" aria-hidden="false">
    {%- for n in (1..4) -%}
      {%- for l in lines -%}{%- assign t = l | strip -%}{%- if t != blank -%}
        <span class="rz-marquee__item" {% if n > 1 %}aria-hidden="true"{% endif %}>{{ t }} {% render 'rz-icon', name: section.settings.icono %}</span>
      {%- endif -%}{%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Rizelune · Banda móvil",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "items",
      "label": "Frases (una por línea)",
      "default": "Romero y menta\nCuida desde la raíz\nFórmula vegana\nHecho en la UE\nRitual de 15 minutos"
    },
    {
      "type": "select",
      "id": "icono",
      "label": "Separador",
      "options": [
        {
          "value": "hoja",
          "label": "Hoja"
        },
        {
          "value": "gota",
          "label": "Gota"
        },
        {
          "value": "raiz",
          "label": "Raíz"
        },
        {
          "value": "brillo",
          "label": "Brillo"
        },
        {
          "value": "fuerza",
          "label": "Fuerza (cabello)"
        },
        {
          "value": "luna",
          "label": "Luna"
        },
        {
          "value": "reloj",
          "label": "Reloj"
        },
        {
          "value": "escudo",
          "label": "Escudo"
        },
        {
          "value": "candado",
          "label": "Candado"
        },
        {
          "value": "caja",
          "label": "Caja"
        },
        {
          "value": "eu",
          "label": "Unión Europea"
        },
        {
          "value": "corazon",
          "label": "Corazón"
        },
        {
          "value": "mensaje",
          "label": "Mensaje"
        },
        {
          "value": "camion",
          "label": "Camión"
        },
        {
          "value": "check",
          "label": "Check"
        }
      ],
      "default": "hoja"
    },
    {
      "type": "range",
      "id": "velocidad",
      "label": "Duración de una vuelta (segundos, más = más lento)",
      "min": 10,
      "max": 80,
      "step": 2,
      "default": 34
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Color de fondo",
      "default": "#DCE3D3"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Color del texto",
      "default": "#2F3B2E"
    },
    {
      "type": "header",
      "content": "Tipografía"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alineación del encabezado",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título",
      "min": 14,
      "max": 60,
      "step": 2,
      "default": 26,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Tamaño del texto",
      "min": 13,
      "max": 26,
      "step": 1,
      "default": 17,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 24,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Rizelune · Banda móvil"
    }
  ]
}
{% endschema %}
