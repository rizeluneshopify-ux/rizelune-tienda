{{ 'rz-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'rz-scripts.js' | asset_url }}" defer="defer"></script>
{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg }};
    color: {{ section.settings.fg }};
  }
  #shopify-section-{{ section.id }} .rz-h1,
  #shopify-section-{{ section.id }} .rz-h2 { font-size: {{ section.settings.heading_size }}px; }
  #shopify-section-{{ section.id }} .rz-body { font-size: {{ section.settings.body_size }}px; }
  #shopify-section-{{ section.id }} .rz-head { text-align: {{ section.settings.text_align }}; }
  #shopify-section-{{ section.id }} .rz-head .rz-eyebrow { justify-content: {% case section.settings.text_align %}{% when 'center' %}center{% when 'right' %}flex-end{% else %}flex-start{% endcase %}; }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.65 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.65 | round }}px; }
    #shopify-section-{{ section.id }} .rz-h1,
    #shopify-section-{{ section.id }} .rz-h2 { font-size: {{ section.settings.heading_size | times: 0.68 | round }}px; }
  }
  
{%- endstyle -%}
<section class="rz-section">
  <div class="rz-container">
    <div class="rz-head rz-reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="rz-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.titulo != blank -%}<h2 class="rz-h2">{{ section.settings.titulo }}</h2>{%- endif -%}
      {%- if section.settings.texto != blank -%}<p class="rz-body">{{ section.settings.texto | newline_to_br }}</p>{%- endif -%}
    </div>
    <div class="rz-grid" style="--rz-cols: {{ section.settings.columnas }}; --rz-gap: {{ section.settings.separacion }}px;">
      {%- for block in section.blocks -%}
        <article class="rz-card rz-reveal" style="--rz-delay: {{ forloop.index0 | times: 110 }}ms" {{ block.shopify_attributes }}>
          <div class="rz-card__img">
            {%- if block.settings.imagen != blank -%}
              {{ block.settings.imagen | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 990px) 25vw, 50vw' }}
            {%- else -%}
              <div style="width:100%;height:100%;background:linear-gradient(160deg,#B9C4AE,#4A5A47)"></div>
            {%- endif -%}
          </div>
          <span class="rz-card__num">0{{ forloop.index }}</span>
          <div class="rz-card__body">
            <h3 class="rz-h3">{{ block.settings.titulo }}</h3>
            <p>{{ block.settings.texto | newline_to_br }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rizelune · Ingredientes",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Encabezado"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo (texto pequeño)",
      "default": "Lo que lleva dentro"
    },
    {
      "type": "text",
      "id": "titulo",
      "label": "Título",
      "default": "Pocos ingredientes, <em>bien</em> elegidos",
      "info": "Pon una palabra entre <em> y </em> para destacarla en cursiva."
    },
    {
      "type": "textarea",
      "id": "texto",
      "label": "Texto",
      "default": "Una mezcla sencilla de aceites vegetales pensada para nutrir el cuero cabelludo."
    },
    {
      "type": "header",
      "content": "Tarjetas"
    },
    {
      "type": "range",
      "id": "columnas",
      "label": "Tarjetas por fila (ordenador)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "separacion",
      "label": "Separación entre tarjetas",
      "min": 8,
      "max": 48,
      "step": 2,
      "default": 22,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Color de fondo",
      "default": "#F5EFE6"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Color del texto",
      "default": "#2F3B2E"
    },
    {
      "type": "header",
      "content": "Tipografía"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alineación del encabezado",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título",
      "min": 24,
      "max": 88,
      "step": 2,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Tamaño del texto",
      "min": 13,
      "max": 26,
      "step": 1,
      "default": 17,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 100,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "ingrediente",
      "name": "Ingrediente",
      "settings": [
        {
          "type": "image_picker",
          "id": "imagen",
          "label": "Imagen"
        },
        {
          "type": "text",
          "id": "titulo",
          "label": "Nombre",
          "default": "Romero"
        },
        {
          "type": "textarea",
          "id": "texto",
          "label": "Descripción",
          "default": "Descripción breve del ingrediente."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Rizelune · Ingredientes",
      "blocks": [
        {
          "type": "ingrediente"
        },
        {
          "type": "ingrediente"
        },
        {
          "type": "ingrediente"
        }
      ]
    }
  ]
}
{% endschema %}
